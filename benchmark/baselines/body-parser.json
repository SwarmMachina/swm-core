{
  "schemaVersion": "regression-ci-baseline/v1",
  "suite": "body-parser",
  "benchmark": {
    "name": "body-parser-ci",
    "packageName": "@swarmmachina/swm-core",
    "packageVersion": "4.1.0",
    "runner": "benchmark/regression-ci.js",
    "script": "pnpm profile:ci --suite body-parser",
    "framework": "core"
  },
  "calibration": {
    "status": "self-hosted-calibrated",
    "updatedAt": "2026-07-25",
    "node": "24.16.0",
    "benchkit": "0.2.0",
    "swmUws": "0.5.6",
    "ciRunner": "self-hosted (Ubuntu 24.04, Intel Xeon E5-2680 v4, dedicated, schedutil)",
    "note": "Calibrated from 4 self-hosted benchkit series. nsPerByte is the primary guard; memory ceilings catch leaks or bloat. rssMB is report-only."
  },
  "parameters": {
    "size": 1048576,
    "chunk": 16384,
    "iters": 10000,
    "warm": 1000,
    "cpuProfile": true
  },
  "metrics": {
    "nsPerByte": { "label": "cost", "unit": "ns/byte" },
    "itersPerSec": { "label": "throughput", "unit": "iters/s" },
    "mbPerSec": { "label": "bandwidth", "unit": "MiB/s" },
    "heapMB": { "label": "heap peak", "unit": "MB" },
    "externalMB": { "label": "external peak", "unit": "MB" },
    "arrayBuffersMB": { "label": "arrayBuffers peak", "unit": "MB" },
    "rssMB": { "label": "rss peak", "unit": "MB" }
  },
  "tests": {
    "known": {
      "description": "BodyParser with known Content-Length",
      "observedMedian": {
        "itersPerSec": 4938.86,
        "mbPerSec": 4938.86,
        "nsPerByte": 0.19,
        "rssMB": 178.83,
        "heapMB": 5.07,
        "externalMB": 114.93,
        "arrayBuffersMB": 113.04
      },
      "guards": {
        "nsPerByte": { "max": 0.25 },
        "heapMB": { "max": 12 },
        "externalMB": { "max": 150 },
        "arrayBuffersMB": { "max": 150 }
      },
      "reportOnly": ["itersPerSec", "mbPerSec", "rssMB"]
    },
    "unknown": {
      "description": "BodyParser with unknown Content-Length (streamed)",
      "observedMedian": {
        "itersPerSec": 2824.84,
        "mbPerSec": 2824.84,
        "nsPerByte": 0.34,
        "rssMB": 152.85,
        "heapMB": 4.76,
        "externalMB": 89.76,
        "arrayBuffersMB": 85.88
      },
      "guards": {
        "nsPerByte": { "max": 0.42 },
        "heapMB": { "max": 12 },
        "externalMB": { "max": 150 },
        "arrayBuffersMB": { "max": 150 }
      },
      "reportOnly": ["itersPerSec", "mbPerSec", "rssMB"]
    }
  },
  "cpuProfileGuard": {
    "profileRequired": true,
    "minTotalTicks": 100,
    "note": "Sanity check only. GC% is high by design (allocation-heavy), so it is not guarded."
  }
}
