{
  "schemaVersion": "regression-ci-baseline/v1",
  "suite": "http",
  "benchmark": {
    "name": "http-core-ci",
    "packageName": "@swarmmachina/swm-core",
    "packageVersion": "2.0.3",
    "runner": "benchmark/regression-ci.js",
    "script": "pnpm profile:ci --suite http",
    "framework": "core"
  },
  "calibration": {
    "status": "self-hosted-calibrated",
    "updatedAt": "2026-07-19",
    "node": "24.17.x",
    "ciRunner": "self-hosted (Ubuntu 24.04, Intel Xeon E5-2680 v4, dedicated, schedutil)",
    "note": "Calibrated from 4 self-hosted series with 3 runs per scenario. Throughput spread was 4-8%; memory was stable. RPS floors sit 11-13% below the slowest series and p99 ceilings tolerate isolated scheduler spikes. rssMB is report-only."
  },
  "parameters": {
    "runs": 3,
    "warmupSec": 2,
    "durationSec": 6,
    "connections": 100,
    "sampleMs": 250,
    "cpuProfile": true
  },
  "metrics": {
    "rps": { "label": "RPS", "unit": "req/s" },
    "latencyP99Ms": { "label": "p99", "unit": "ms" },
    "errors": { "label": "errors", "unit": "" },
    "heapMB": { "label": "heap peak", "unit": "MB" },
    "externalMB": { "label": "external peak", "unit": "MB" },
    "arrayBuffersMB": { "label": "arrayBuffers peak", "unit": "MB" },
    "rssMB": { "label": "rss peak", "unit": "MB" }
  },
  "tests": {
    "base-sync": {
      "description": "GET /base-sync synchronous JSON response hot path",
      "observedMedian": {
        "rps": 162571,
        "latencyAvgMs": 5.87,
        "latencyP97_5Ms": 6,
        "latencyP99Ms": 6,
        "errors": 0,
        "eluPct": 97.16,
        "eventLoopDelayP99Ms": 22.1,
        "rssMB": 73.44,
        "heapMB": 10.99,
        "externalMB": 3.63,
        "arrayBuffersMB": 0.04
      },
      "guards": {
        "rps": { "min": 140000 },
        "latencyP99Ms": { "max": 14 },
        "errors": { "max": 0 },
        "heapMB": { "max": 18 },
        "externalMB": { "max": 6 },
        "arrayBuffersMB": { "max": 2 }
      },
      "reportOnly": ["latencyAvgMs", "latencyP97_5Ms", "eluPct", "eventLoopDelayP99Ms", "rssMB"]
    },
    "base-async": {
