{
  "schemaVersion": "regression-ci-baseline/v1",
  "suite": "http",
  "benchmark": {
    "name": "http-core-ci",
    "packageName": "@swarmmachina/swm-core",
    "packageVersion": "4.1.0",
    "runner": "benchmark/regression-ci.js",
    "script": "pnpm profile:ci --suite http",
    "framework": "core"
  },
  "calibration": {
    "status": "self-hosted-calibrated",
    "updatedAt": "2026-07-25",
    "node": "24.16.0",
    "benchkit": "0.2.0",
    "swmUws": "0.5.6",
    "ciRunner": "self-hosted (Ubuntu 24.04, Intel Xeon E5-2680 v4, dedicated, schedutil)",
    "note": "Calibrated from 4 self-hosted benchkit series with 3 runs per scenario. RPS floors sit 12-14% below the slowest series median; p99 ceilings include observed per-run scheduler spikes. Memory was stable and rssMB is report-only."
  },
  "parameters": {
    "runs": 3,
    "warmupSec": 2,
    "durationSec": 6,
    "connections": 100,
    "sampleMs": 250,
    "cpuProfile": true
  },
  "metrics": {
    "rps": { "label": "RPS", "unit": "req/s" },
    "latencyP99Ms": { "label": "p99", "unit": "ms" },
    "errors": { "label": "errors", "unit": "" },
    "heapMB": { "label": "heap peak", "unit": "MB" },
    "externalMB": { "label": "external peak", "unit": "MB" },
    "arrayBuffersMB": { "label": "arrayBuffers peak", "unit": "MB" },
    "rssMB": { "label": "rss peak", "unit": "MB" }
  },
  "tests": {
    "base-sync": {
      "description": "GET /base-sync synchronous JSON response hot path",
      "observedMedian": {
        "rps": 211116,
        "latencyAvgMs": 4.71,
        "latencyP97_5Ms": 6.26,
        "latencyP99Ms": 9.22,
        "errors": 0,
        "eluPct": 98.78,
        "eventLoopDelayP99Ms": 23.44,
        "rssMB": 81.97,
        "heapMB": 16.29,
        "externalMB": 3.64,
        "arrayBuffersMB": 0.04
      },
      "guards": {
        "rps": { "min": 180000 },
        "latencyP99Ms": { "max": 12 },
        "errors": { "max": 0 },
        "heapMB": { "max": 18 },
        "externalMB": { "max": 6 },
        "arrayBuffersMB": { "max": 2 }
      },
      "reportOnly": ["latencyAvgMs", "latencyP97_5Ms", "eluPct", "eventLoopDelayP99Ms", "rssMB"]
    },
    "base-async": {
      "description": "GET /base-async asynchronous JSON response hot path",
