{
  "schemaVersion": "regression-ci-baseline/v1",
  "suite": "ws-upgrade",
  "benchmark": {
    "name": "ws-upgrade-core-ci",
    "runner": "benchmark/regression-ci.js",
    "script": "pnpm profile:ci --suite ws-upgrade",
    "framework": "core"
  },
  "calibration": {
    "status": "uncalibrated",
    "note": "Throughput and latency are report-only until calibrated on the self-hosted CI runner. Errors and CPU profile integrity are guarded immediately."
  },
  "parameters": {
    "runs": 1,
    "warmupSec": 1,
    "durationSec": 2,
    "concurrency": 20,
    "sampleMs": 250,
    "cpuProfile": true
  },
  "metrics": {
    "upgradesPerSec": { "label": "upgrades", "unit": "upgrade/s" },
    "latP99Ms": { "label": "p99 handshake", "unit": "ms" },
    "errors": { "label": "errors", "unit": "" },
    "heapMB": { "label": "heap peak", "unit": "MB" }
  },
  "tests": {
    "sync": {
      "description": "Synchronous onUpgrade authorization",
      "guards": { "errors": { "max": 0 } },
      "reportOnly": [
        "upgradesPerSec",
        "latAvgMs",
        "latP95Ms",
        "latP99Ms",
        "eluPct",
        "eventLoopDelayP99Ms",
        "rssMB",
        "heapMB",
        "externalMB",
        "arrayBuffersMB"
      ]
    },
    "async": {
      "description": "Immediately resolved asynchronous onUpgrade authorization",
      "guards": { "errors": { "max": 0 } },
      "reportOnly": [
        "upgradesPerSec",
        "latAvgMs",
        "latP95Ms",
        "latP99Ms",
        "eluPct",
        "eventLoopDelayP99Ms",
        "rssMB",
        "heapMB",
        "externalMB",
        "arrayBuffersMB"
      ]
    }
  },
  "cpuProfileGuard": {
    "profileRequired": true,
    "minTotalTicks": 50,
    "maxGcPct": 8,
    "maxUnaccountedPct": 25,
    "note": "Integrity guard; recalibrate after collecting profiles on the self-hosted runner."
  }
}
