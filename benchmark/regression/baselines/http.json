{
  "schemaVersion": "regression-ci-baseline/v1",
  "suite": "http",
  "benchmark": {
    "name": "http-core-ci",
    "packageName": "@swarmmachina/swm-core",
    "packageVersion": "4.1.0",
    "runner": "benchmark/regression/ci.js",
    "script": "pnpm profile:ci --suite http",
    "framework": "core"
  },
  "calibration": {
    "status": "self-hosted-calibrated",
    "updatedAt": "2026-09-04",
    "node": "24.16.0 (response stream); 24.17.0 (upload)",
    "benchkit": "0.3.0",
    "swmUws": "0.8.0",
    "ciRunner": "self-hosted (Ubuntu 24.04, Intel Xeon E5-2680 v4, dedicated, schedutil)",
    "note": "Base scenarios retain their 2026-07-25 calibration; a post-calibration CI run observed 2.18 MiB arrayBuffers in every base control, so their cap is 3 MiB. On 2026-09-03, upload scenarios were calibrated from 4 self-hosted Node 24.17.0 benchkit series with 3 runs per scenario. Their RPS floors sit 12.5-13.3% below the slowest series median and p99 ceilings include observed per-run scheduler spikes. On 2026-09-04, response stream was calibrated from one full CI profile plus 3 dedicated self-hosted Node 24.16.0 series, each with 3 runs: same-run ratios were 0.1170, 0.1201, 0.1241, and 0.1376; its 0.11 floor is 6% below the slowest series. rssMB is report-only. Static and response-stream scenarios use portable same-run RPS ratios."
  },
  "parameters": {
    "runs": 3,
    "warmupSec": 2,
    "durationSec": 6,
    "connections": 100,
    "sampleMs": 250,
    "cpuProfile": true,
    "testConnections": {
      "static-cache-miss": 25,
      "stream-backpressure": 10,
      "upload-stream-backpressure": 10
    }
  },
  "metrics": {
    "rps": { "label": "RPS", "unit": "req/s" },
    "latencyP99Ms": { "label": "p99", "unit": "ms" },
    "errors": { "label": "errors", "unit": "" },
    "heapMB": { "label": "heap peak", "unit": "MB" },
    "externalMB": { "label": "external peak", "unit": "MB" },
    "arrayBuffersMB": { "label": "arrayBuffers peak", "unit": "MB" },
    "rssMB": { "label": "rss peak", "unit": "MB" },
    "rpsRelativeToBaseSync": { "label": "RPS / base-sync", "unit": "ratio" },
    "backpressurePauses": { "label": "observed Readable pauses", "unit": "events" },
    "backpressureResumes": { "label": "observed Readable resumes", "unit": "events" },
    "backpressureQueuePeakBytes": { "label": "request stream queue peak", "unit": "bytes" },
    "backpressureQueueLimitBytes": { "label": "request stream queue limit", "unit": "bytes" }
  },
  "tests": {
