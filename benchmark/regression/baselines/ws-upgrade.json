{
  "schemaVersion": "regression-ci-baseline/v1",
  "suite": "ws-upgrade",
  "benchmark": {
    "name": "ws-upgrade-core-ci",
    "runner": "benchmark/regression/ci.js",
    "script": "pnpm profile:ci --suite ws-upgrade",
    "framework": "core"
  },
  "calibration": {
    "status": "self-hosted-calibrated",
    "updatedAt": "2026-09-03",
    "node": "24.17.0",
    "benchkit": "0.3.0",
    "swmUws": "0.8.0",
    "ciRunner": "self-hosted (Ubuntu 24.04, Intel Xeon E5-2680 v4, dedicated, schedutil)",
    "note": "Calibrated from 4 self-hosted Node 24.17.0 benchkit series with 3 runs per scenario. RPS floors sit 12.7-13.1% below the slowest series median; p99 ceilings include observed per-run scheduler spikes. rssMB is report-only."
  },
  "parameters": {
    "runs": 3,
    "warmupSec": 2,
    "durationSec": 6,
    "concurrency": 20,
    "sampleMs": 250,
    "cpuProfile": true
  },
  "metrics": {
    "upgradesPerSec": { "label": "upgrades", "unit": "upgrade/s" },
    "latP99Ms": { "label": "p99 handshake", "unit": "ms" },
    "errors": { "label": "errors", "unit": "" },
    "heapMB": { "label": "heap peak", "unit": "MB" }
  },
  "tests": {
    "sync": {
      "description": "Synchronous onUpgrade authorization",
      "observedMedian": {
        "upgradesPerSec": 3246.83,
        "latAvgMs": 2.41,
        "latP95Ms": 2.94,
        "latP99Ms": 3.3,
        "errors": 0,
        "eluPct": 57.63,
        "eventLoopDelayP99Ms": 20.43,
        "rssMB": 68.08,
        "heapMB": 10.76,
        "externalMB": 2.01,
        "arrayBuffersMB": 0.03
      },
      "guards": {
        "upgradesPerSec": { "min": 2800 },
        "latP99Ms": { "max": 6 },
        "errors": { "max": 0 },
        "heapMB": { "max": 14 },
        "externalMB": { "max": 5 },
        "arrayBuffersMB": { "max": 2 }
      },
      "reportOnly": ["latAvgMs", "latP95Ms", "eluPct", "eventLoopDelayP99Ms", "rssMB"]
    },
    "async": {
      "description": "Immediately resolved asynchronous onUpgrade authorization",
      "observedMedian": {
        "upgradesPerSec": 3278.75,
        "latAvgMs": 2.37,
        "latP95Ms": 2.68,
        "latP99Ms": 2.84,
        "errors": 0,
        "eluPct": 63.28,
        "eventLoopDelayP99Ms": 20.42,
        "rssMB": 69.84,
        "heapMB": 11,
        "externalMB": 2.01,
        "arrayBuffersMB": 0.03
      },
      "guards": {
        "upgradesPerSec": { "min": 2800 },
        "latP99Ms": { "max": 5 },
        "errors": { "max": 0 },
        "heapMB": { "max": 14 },
        "externalMB": { "max": 5 },
        "arrayBuffersMB": { "max": 2 }
      },
      "reportOnly": ["latAvgMs", "latP95Ms", "eluPct", "eventLoopDelayP99Ms", "rssMB"]
    }
  },
  "cpuProfileGuard": {
    "profileRequired": true,
    "minTotalTicks": 50,
    "maxGcPct": 8,
    "maxUnaccountedPct": 25,
    "note": "Integrity guard. CPU profiles are verified in the post-calibration regression run."
  }
}
