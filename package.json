{
  "name": "@swarmmachina/swm-core",
  "version": "4.0.1",
  "description": "High-performance HTTP/WebSocket server built on swm-uws",
  "keywords": [
    "http",
    "websocket",
    "server",
    "zero-dependency",
    "performance",
    "swarmmachina",
    "uwebsockets",
    "fast"
  ],
  "author": "SwarmMachina Team",
  "license": "MPL-2.0",
  "packageManager": "pnpm@11.3.0",
  "main": "src/index.js",
  "types": "./src/index.d.ts",
  "type": "module",
  "engines": {
    "node": "22.x || 24.x"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "imports": {
    "#uws-binding": {
      "uwebsockets-reference": "uwebsockets.js",
      "default": "@swarmmachina/swm-uws"
    }
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwarmMachina/swm-core.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "prettier . --check && eslint . --ext .js,.vue",
    "fix": "prettier . --write && eslint . --ext .js,.vue --fix",
    "test": "node --import ./tests/helpers/register-loader.js --test tests/unit/*.test.js",
    "test:coverage": "node --import ./tests/helpers/register-loader.js --test --experimental-test-coverage tests/unit/*.test.js",
    "test:e2e": "node --test tests/e2e/**/*.test.js",
    "test:e2e:http": "node --test tests/e2e/http/*.test.js",
    "test:e2e:ws": "node --test tests/e2e/ws/*.test.js",
    "test:e2e:uwebsockets-reference": "node --conditions=uwebsockets-reference --test tests/e2e/**/*.test.js",
    "test:e2e:bindings": "pnpm test:e2e && pnpm test:e2e:uwebsockets-reference",
    "test:types": "node scripts/test-packed-types.js",
    "test:package": "node scripts/test-package.js",
    "test:leak": "node --expose-gc --test tests/leak/*.leak.test.js",
    "soak": "node --expose-gc tests/soak/soak.js",
    "test:autobahn": "node ./tests/autobahn/run.js",
    "bench": "node ./benchmark/bench.js --test base-sync --runs 1 --warmup 10 --sample-ms 250 --v8prof true",
    "bench:core": "node ./benchmark/bench.js --test base-sync --runs 1 --warmup 10 --sample-ms 250 --v8prof true --fw core",
    "bench:async": "node ./benchmark/bench.js --test base-async --runs 1 --warmup 10 --sample-ms 250 --v8prof true",
    "bench:core:async": "node ./benchmark/bench.js --test base-async --runs 1 --warmup 10 --sample-ms 250 --v8prof true --fw core",
    "bench:headers": "node ./benchmark/bench.js --test headers --runs 1 --warmup 10 --sample-ms 250 --v8prof true",
    "bench:headers:core": "node ./benchmark/bench.js --test headers --runs 1 --warmup 10 --sample-ms 250 --v8prof true --fw core",
    "bench:headers:prepared": "node ./benchmark/bench.js --test headers-prepared --runs 1 --warmup 10 --sample-ms 250 --v8prof true --fw core",
    "bench:ws": "node ./benchmark/ws-bench.js --fw core,ws --runs 1 --warmup 2 --v8prof true",
    "bench:bindings": "node ./benchmark/binding-compare.js",
    "bench:bindings:deep": "node ./benchmark/binding-deep-compare.js",
    "bench:before": "node ./benchmark/before-bench.js",
    "bench:body-prefetch": "node ./benchmark/body-prefetch-bench.js",
    "bench:body-safety": "node ./benchmark/body-safety-bench.js",
    "profile:ci": "node ./benchmark/regression-ci.js",
    "profile:compare": "node ./benchmark/compare-ci.js",
    "profile:compare:http": "node ./benchmark/compare-ci.js --suite http",
    "profile:compare:ws": "node ./benchmark/compare-ci.js --suite ws",
    "deps:update:bindings": "node scripts/update-bindings.js",
    "release:verify-tag": "node scripts/verify-release.js",
    "release:artifact": "node scripts/build-release-artifact.js",
    "release:gate": "pnpm check && pnpm test && pnpm test:e2e:bindings && pnpm test:types && pnpm test:package",
    "prepublishOnly": "pnpm release:gate",
    "release": "pnpm release:gate && pnpm release:artifact && node release-artifact/publish-release-artifact.js"
  },
  "devDependencies": {
    "@swarmmachina/standards": "^1.1.2",
    "@types/node": "24.10.1",
    "autocannon": "^8.0.0",
    "eslint": "10.7.0",
    "express": "^5.2.1",
    "fastify": "^5.8.5",
    "hdr-histogram-percentiles-obj": "3.0.0",
    "micro": "^10.0.1",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "uwebsockets.js": "github:uNetworking/uWebSockets.js#v20.69.0",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "@swarmmachina/swm-uws": "0.5.4"
  }
}
