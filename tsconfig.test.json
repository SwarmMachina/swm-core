{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src/**/*.js", "src/**/*.ts", "src/**/*.d.ts", "tests/**/*.js", "tests/**/*.ts"],
  "exclude": ["tests/fixtures/types/**"]
}
